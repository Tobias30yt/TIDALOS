#!/bin/sh
set -eu

if [ ! -r /cdrom/casper/filesystem.squashfs ]; then
    zenity --error --title="TIDALOS-Installer" \
        --text="Der Installer muss aus der TIDALOS-Live-ISO gestartet werden."
    exit 1
fi

branding="/etc/calamares/branding/tidalos/branding.desc"
slideshow="/etc/calamares/branding/tidalos/show.qml"
release="/etc/tidalos-release"
if [ ! -r "$release" ] || ! grep -qx 'IMAGE_BUILD=r4' "$release" ||
   [ ! -r "$branding" ] || ! grep -q '^slideshow: "show.qml"$' "$branding" || [ ! -r "$slideshow" ]; then
    zenity --error --title="TIDALOS-Installer" \
        --text="Die Calamares-Branding-Dateien fehlen oder sind veraltet. Bitte Build r4 von der ISO starten."
    exit 1
fi

exec sudo -E /usr/bin/calamares
